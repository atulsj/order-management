ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://oms_user:local_dev_password@127.0.0.1:5432/order_management
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
CORS_ORIGINS=["http://localhost:4200","http://localhost:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
KEYCLOAK_ISSUER=http://localhost:8180/realms/oms
KEYCLOAK_AUDIENCE=oms-api
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/oms/protocol/openid-connect/certs
AUTH_DISABLED=false
PAYMENT_PROVIDER=simulator
SIMULATOR_OUTCOME=SUCCEEDED
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD
RECONCILIATION_DEADLINE_HOURS=24
ORDER_RESERVATION_MINUTES=30
BROKER_URL=amqp://oms:local_dev_password@localhost:5672//
RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
PAYMENT_RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BYTES=1048576
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
LOG_LEVEL=INFO
LOG_JSON=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
